[
	{
		"id": 1,
		"text": "工作再忙，也要记得好好吃饭。",
		"tags": [
			"职场"
		]
	},
	{
		"id": 2,
		"text": "专业的事交给专业的人，专注的事留给自己。",
		"tags": [
			"职场"
		]
	},
	{
		"id": 3,
		"text": "今天的努力，是明天选择的底气。",
		"tags": [
			"职场",
			"励志"
		]
	},
	{
		"id": 4,
		"text": "靠谱，比聪明更重要。",
		"tags": [
			"职场"
		]
	},
	{
		"id": 5,
		"text": "向上生长，向下扎根。",
		"tags": [
			"职场"
		]
	},
	{
		"id": 6,
		"text": "把每一件小事做到极致，就是最好的竞争力。",
		"tags": [
			"职场"
		]
	},
	{
		"id": 7,
		"text": "周一元气满满，周五快乐下班。",
		"tags": [
			"职场",
			"日常"
		]
	},
	{
		"id": 8,
		"text": "工作是为了更好的生活，不是为了透支生活。",

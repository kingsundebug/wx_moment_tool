[
	{
		"id": 1,
		"text": "遇见你是所有故事的开始。",
		"tags": [
			"情感"
		]
	},
	{
		"id": 2,
		"text": "喜欢是藏不住的，眼睛会出卖一切。",
		"tags": [
			"情感"
		]
	},
	{
		"id": 3,
		"text": "最好的关系，是彼此独立又相互依靠。",
		"tags": [
			"情感"
		]
	},
	{
		"id": 4,
		"text": "愿有人陪你颠沛流离，愿有人陪你立黄昏。",
		"tags": [
			"情感"
		]
	},
	{
		"id": 5,
		"text": "斯人若彩虹，遇上方知有。",
		"tags": [
			"文艺"
		]
	},
	{
		"id": 6,
		"text": "陪伴是最长情的告白。",
		"tags": [
			"情感"
		]
	},
	{
		"id": 7,
		"text": "你是温暖的手套，冰冷的啤酒，阳光下的冰美式。",
		"tags": [
			"文艺"
		]
	},
	{
		"id": 8,
		"text": "山河远阔，人间烟火，无一是你，无一不是你。",
		"tags": [
			"情感"
		]
	},
	{
		"id": 9,
		"text": "想懂爱人，是我心里最柔软的事。",
		"tags": [
			"情感",
			"祝福"
		]
	},
	{
		"id": 10,
		"text": "关于告别，我满心欢喜。",
		"tags": [
			"亲情"
		]
	},
	{
		"id": 11,
		"text": "我想把所有的温柔都给你。",
		"tags": [
			"友情"
		]
	},
	{
		"id": 12,
		"text": "每一次对视，都令人心动。",
		"tags": [
			"情感"
		]
	},
	{
		"id": 13,
		"text": "把安静留给朋友，是我能想到最好的答案。",
		"tags": [
			"情感"
		]
	},
	{
		"id": 14,
		"text": "想懂朋友，是我心里最柔软的事。",
		"tags": [
			"情感",
			"祝福"
		]
	},
	{
		"id": 15,
		"text": "友情是细水长流的陪伴。",
		"tags": [
			"亲情"
		]
	},
	{
		"id": 16,
		"text": "距离再远，也隔不断想念。",
		"tags": [
			"文艺"
		]
	},
	{
		"id": 17,
		"text": "每一次初见，都很珍贵。",
		"tags": [
			"亲情"
		]
	},
	{
		"id": 18,
		"text": "在雨夜想起重要的人，心里就会变软。",
		"tags": [
			"温暖"
		]
	},
	{
		"id": 19,
		"text": "在晴天想起家人，心里就会变软。",
		"tags": [
			"友情"
		]
	},
	{
		"id": 20,
		"text": "把坚定留给重要的人，是我能想到最好的答案。",
		"tags": [
			"情感"
		]
	},
	{
		"id": 21,
		"text": "把热烈留给爱人，是我能想到最好的答案。",
		"tags": [
			"文艺"
		]
	},
	{
		"id": 22,
		"text": "每一次告别，都令人心动。",
		"tags": [
			"亲情"
		]
	},
	{
		"id": 23,

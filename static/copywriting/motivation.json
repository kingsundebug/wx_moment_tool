[
	{
		"id": 1,
		"text": "生活不会一直顺利，但也不会一直糟糕。你只管努力，时间会给你答案。",
		"tags": [
			"励志",
			"早安"
		]
	},
	{
		"id": 2,
		"text": "所有的光芒，都需要时间才能被看见。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 3,
		"text": "不必追光，你本身就是光。",
		"tags": [
			"励志",
			"晚安"
		]
	},
	{
		"id": 4,
		"text": "今天比昨天更进步一点点，就是了不起的胜利。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 5,
		"text": "熬过无人问津的日子，才有诗和远方。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 6,
		"text": "你要悄悄拔尖，然后惊艳所有人。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 7,
		"text": "种一棵树最好的时间是十年前，其次是现在。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 8,
		"text": "星光不问赶路人，时光不负追梦人。",
		"tags": [
			"励志",
			"晚安"
		]
	},
	{
		"id": 9,
		"text": "纵有疾风起，人生不言弃。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 10,
		"text": "每一个不曾起舞的日子，都是对生命的辜负。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 11,
		"text": "今天，都不会白费。",
		"tags": [
			"读书"
		]
	},
	{
		"id": 12,
		"text": "请继续沉淀，机会会主动靠近。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 13,
		"text": "请继续坚持，命运会悄悄奖励你。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 14,
		"text": "保持耐心，时间会给你转机。",
		"tags": [
			"健身"
		]
	},
	{
		"id": 15,
		"text": "业精于勤荒于嬉，行成于思毁于随。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 16,
		"text": "保持自律，时间会给你答案。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 17,
		"text": "与其拖延，不如坚持。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 18,
		"text": "看起来普通的一天，都不会白费。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 19,
		"text": "此刻，都在悄悄改写结局。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 20,
		"text": "每一次跌倒后，都在为未来的你铺路。",
		"tags": [
			"读书"
		]
	},
	{
		"id": 21,
		"text": "今天，都是成长的一部分。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 22,
		"text": "与其比较，不如出发。",
		"tags": [
			"读书"
		]
	},
	{
		"id": 23,
		"text": "会当凌绝顶，一览众山小。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 24,
		"text": "所有默默坚持的日子，都在积累底气。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 25,
		"text": "请继续专注，命运会悄悄奖励你。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 26,
		"text": "请继续改变，你会感谢现在的自己。",
		"tags": [
			"励志"
		]
	},
	{
		"id": 27,
		"text": "与其怀疑，不如努力。",
		"tags": [

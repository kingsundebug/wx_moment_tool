[
	{
		"id": 1,
		"text": "新年快乐，愿所念皆如愿，所行皆坦途。",
		"tags": [
			"春节"
		]
	},
	{
		"id": 2,
		"text": "中秋快乐，月圆人团圆。",
		"tags": [
			"中秋"
		]
	},
	{
		"id": 3,
		"text": "生日快乐，愿你不负韶华，未来可期。",
		"tags": [
			"生日"
		]
	},
	{
		"id": 4,
		"text": "圣诞快乐，愿平安喜乐常伴左右。",
		"tags": [
			"圣诞"
		]
	},
	{
		"id": 5,
		"text": "情人节快乐，愿爱与被爱同时发生。",
		"tags": [
			"情人节"
		]
	},
	{
		"id": 6,
		"text": "端午安康，愿你我皆平安。",
		"tags": [
			"端午"
		]
	},
	{
		"id": 7,
		"text": "国庆快乐，祝福祖国繁荣昌盛。",
		"tags": [
			"国庆"
		]
	},
	{
		"id": 8,
		"text": "元旦快乐，新的一年，新的开始。",
		"tags": [
			"元旦"
		]
	},
	{
		"id": 9,
		"text": "小年到了，愿你圆满。",
		"tags": [
			"小年"
		]
	},
	{
		"id": 10,
		"text": "祝你在中秋顺遂。",
		"tags": [
			"中秋"
		]
	},
	{
		"id": 11,
		"text": "一轮明月，寄相思。",
		"tags": [
			"中秋"
		]
	},
	{
		"id": 12,
		"text": "母亲节到了，愿你圆满。",
		"tags": [
			"母亲节"
		]
	},
	{
		"id": 13,
		"text": "祝你在圣诞喜乐。",
		"tags": [
			"圣诞"
		]
	},
	{
		"id": 14,
		"text": "婚礼到了，愿你顺遂。",
		"tags": [
			"婚礼"
		]
	},
	{
		"id": 15,
		"text": "母亲节快乐，妈妈辛苦了，我爱您。",
		"tags": [
			"母亲节"
		]
